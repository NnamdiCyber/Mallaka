{
  "name": "@mallaka/contract-bindings",
  "private": true,
  "version": "0.1.0",
  "description": "Mallaka generated TypeScript contract bindings",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./lease": {
      "types": "./dist/lease/src/index.d.ts",
      "import": "./dist/lease/src/index.js"
    },
    "./title-registry": {
      "types": "./dist/title-registry/src/index.d.ts",
      "import": "./dist/title-registry/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
