{
  "name": "@mallaka/api",
  "private": true,
  "version": "0.1.0",
  "description": "Mallaka REST API service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "bash -c 'shopt -s globstar; node --import tsx --test test/**/*.test.ts'",
    "openapi": "tsx src/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@mallaka/notifier": "workspace:*",
    "@mallaka/payments": "workspace:*",
    "@mallaka/shared": "workspace:*",
    "@stellar/stellar-sdk": "^17.4.0",
    "fastify": "^4.26.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^8.57.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  }
}
