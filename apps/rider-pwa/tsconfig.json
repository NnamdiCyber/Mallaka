{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmitOnError": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*", "next.config.js", "next.config.mjs"],
  "exclude": ["node_modules", "dist", ".next"]
}